{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^26.0.0",
        "npm": ">=11.0.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^26.0.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=11.0.0",
            "onFail": "error"
        }
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "npm run lint:js && npm run lint:css && npm run lint:blade",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"resources/css/**/*.css\"",
        "lint:blade": "blade-formatter --check-formatted \"resources/views/**/*.blade.php\"",
        "format": "prettier --write . && stylelint \"resources/css/**/*.css\" --fix && blade-formatter --write \"resources/views/**/*.blade.php\"",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@alpinejs/csp": "^3.17.5",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.4",
        "blade-formatter": "^1.44.6",
        "concurrently": "^10.0.6",
        "eslint": "^10.14.0",
        "fontaine": "^1.0.3",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.2.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "stylelint": "^18.0.0",
        "stylelint-config-standard": "^41.0.0",
        "tailwindcss": "^4.3.4",
        "vite": "^8.3.6"
    },
    "overrides": {
        "postcss-selector-parser": "^7.1.6"
    }
}
